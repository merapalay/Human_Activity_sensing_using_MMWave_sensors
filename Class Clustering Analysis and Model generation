{"cells":[{"cell_type":"code","source":["import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.decomposition import PCA\n","from sklearn.cluster import KMeans\n","import os\n","\n","def analyze_clusters(filepath):\n","    print(f\"Loading dataset from {filepath}...\")\n","    # Load the dataset\n","    df = pd.read_csv(filepath)\n","\n","    # Drop rows with missing values just in case\n","    df = df.dropna()\n","\n","    # Separate features (X) and target/classes (y)\n","    # Assuming 'activity' is the target column based on the dataset snippet\n","    if 'activity' not in df.columns:\n","        raise ValueError(\"The dataset must contain a 'activity' column.\")\n","\n","    X = df.drop('activity', axis=1)\n","    y = df['activity']\n","\n","    print(\"Scaling features...\")\n","    # Standardize the features (important for PCA and K-Means)\n","    scaler = StandardScaler()\n","    X_scaled = scaler.fit_transform(X)\n","\n","    print(\"Applying PCA for 2D visualization...\")\n","    # Reduce dimensions to 2 using PCA for visualization\n","    pca = PCA(n_components=2)\n","    X_pca = pca.fit_transform(X_scaled)\n","\n","    # Create a DataFrame for plotting\n","    plot_df = pd.DataFrame(data=X_pca, columns=['Principal Component 1', 'Principal Component 2'])\n","    plot_df['Actual Class'] = y.values\n","\n","    # Determine the number of unique classes to set the K-Means clusters\n","    num_classes = len(y.unique())\n","    print(f\"Detected {num_classes} unique classes: {y.unique().tolist()}\")\n","\n","    print(f\"Running K-Means clustering with k={num_classes}...\")\n","    # Apply K-Means Clustering\n","    kmeans = KMeans(n_clusters=num_classes, random_state=42, n_init=10)\n","    cluster_activitys = kmeans.fit_predict(X_scaled)\n","\n","    # Add cluster activitys to our plotting dataframe and the original dataframe\n","    plot_df['KMeans Cluster'] = cluster_activitys\n","    df['Assigned_Cluster'] = cluster_activitys\n","\n","    # --- Visualization 1: Actual Classes ---\n","    plt.figure(figsize=(14, 6))\n","\n","    plt.subplot(1, 2, 1)\n","    sns.scatterplot(\n","        x='Principal Component 1',\n","        y='Principal Component 2',\n","        hue='Actual Class',\n","        palette='viridis',\n","        data=plot_df,\n","        alpha=0.7\n","    )\n","    plt.title('Clusters based on Actual Classes (activity)')\n","    plt.legend(title='Classes', bbox_to_anchor=(1.05, 1), loc='upper left')\n","\n","    # --- Visualization 2: K-Means Unsupervised Clusters ---\n","    plt.subplot(1, 2, 2)\n","    sns.scatterplot(\n","        x='Principal Component 1',\n","        y='Principal Component 2',\n","        hue='KMeans Cluster',\n","        palette='tab10',\n","        data=plot_df,\n","        alpha=0.7\n","    )\n","    plt.title(f'K-Means Clustering Results (k={num_classes})')\n","    plt.legend(title='Clusters', bbox_to_anchor=(1.05, 1), loc='upper left')\n","\n","    plt.tight_layout()\n","\n","    # Save the plot\n","    plot_filename = 'class_clusters_visualization.png'\n","    plt.savefig(plot_filename, dpi=300, bbox_inches='tight')\n","    print(f\"Saved cluster visualization to {plot_filename}\")\n","    plt.show()\n","\n","    # Save the new dataset with assigned clusters\n","    output_filename = 'ETL_Dataset_with_Clusters.csv'\n","    df.to_csv(output_filename, index=False)\n","    print(f\"Saved dataset with new 'Assigned_Cluster' column to {output_filename}\")\n","\n","if __name__ == \"__main__\":\n","    # Ensure the script runs on the provided filename\n","    dataset_file = 'ADD THE ADDRESS OF THE DATASET'\n","    if os.path.exists(dataset_file):\n","        analyze_clusters(dataset_file)\n","    else:\n","        print(f\"Error: Could not find '{dataset_file}' in the current directory.\")"],"outputs":[{"output_type":"stream","name":"stdout","text":["Loading dataset from /content/drive/MyDrive/IOT_PROJECT/Dataset/ETL_Balanced_Cleaned_Dataset_after_heatmap.csv...\n","Scaling features...\n","Applying PCA for 2D visualization...\n","Detected 6 unique classes: ['SITTING', 'EXIT WALK', 'ENTRY WALK', 'STANDING', 'WALKING', 'NO_PERSON']\n","Running K-Means clustering with k=6...\n","Saved cluster visualization to class_clusters_visualization.png\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saved dataset with new 'Assigned_Cluster' column to ETL_Dataset_with_Clusters.csv\n"]}],"execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":730},"id":"-zquCYqrIZKB","executionInfo":{"status":"ok","timestamp":1778347649019,"user_tz":-330,"elapsed":32077,"user":{"displayName":"Merapala Yaswanth","userId":"02172872485879549959"}},"outputId":"68676272-f90b-4370-d8f8-d9db2c722efb"}},{"cell_type":"code","source":["from google.colab import drive\n","drive.mount('/content/drive')"],"metadata":{"id":"La7No02IIf2x","executionInfo":{"status":"ok","timestamp":1778347652131,"user_tz":-330,"elapsed":2953,"user":{"displayName":"Merapala Yaswanth","userId":"02172872485879549959"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"a0cbf20e-b793-4ec8-874c-fa9b2b4af2b4"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Drive already mounted at /content/drive; to attempt to forcibly remount, call drive.mount(\"/content/drive\", force_remount=True).\n"]}]},{"cell_type":"code","source":["!pip install micromlgen"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"JXUZcEq_MCjc","executionInfo":{"status":"ok","timestamp":1778347659265,"user_tz":-330,"elapsed":7102,"user":{"displayName":"Merapala Yaswanth","userId":"02172872485879549959"}},"outputId":"0103850c-9aa4-4b6b-9719-1611b8ba08fb"},"execution_count":null,"outputs":[{"output_type":"stream","name":